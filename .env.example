# ---- Anthropic (report analysis) ----
ANTHROPIC_API_KEY=sk-ant-...
# Model used to write the report. Sonnet 5.5 balances quality and cost;
# switch to claude-opus-5-5 for top-tier output if you want to compare.
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Access control (shared secrets) ----
# n8n / website form must send this as the x-api-key header to create jobs.
INTAKE_API_KEY=generate-a-long-random-string
# Required to approve & send (admin UI / approve endpoint).
ADMIN_API_KEY=generate-another-long-random-string

# ---- Job store (REQUIRED in production) ----
# Pick ONE backend:
#  - Railway: add the Redis plugin; it sets REDIS_URL automatically.
#  - Vercel/other: add Upstash Redis and set the two KV_REST_API_* values.
# Without one of these, jobs are kept only in memory and will NOT survive
# between requests or restarts.
REDIS_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Data sources ----
# Free Cert Spotter works without a key but is rate-limited from datacentres.
# A free account token raises limits and widens the history window.
CERTSPOTTER_TOKEN=
# Optional: a Shodan API key to upgrade from the free InternetDB index to the
# full host API (richer, fresher data). Not required for the free path.
SHODAN_API_KEY=
# Safety cap on how many hosts to look up per report.
MAX_HOSTS=40

# ---- Email delivery (Microsoft Graph, app-only) ----
# Entra ID app registration with Mail.Send (application) permission, admin-consented.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER=reports@betechsecure.co.uk

# ---- Branding (used in the PDF) ----
BRAND_NAME=Be Tech Secure
BRAND_PRIMARY=#251A5C
BRAND_ACCENT=#6D4AFF
# Leave BRAND_LOGO_URL blank to use the inlined Be Tech Secure logo. Set it to
# an absolute https URL only if you want to override with a hosted image.
BRAND_LOGO_URL=
BRAND_WEBSITE=www.betechsecure.co.uk
BRAND_WEBSITE_URL=https://www.betechsecure.co.uk
BRAND_EMAIL=
BRAND_PHONE=01483 668400
BRAND_ADDRESS=2nd Floor Export House, 5 Henry Plaza, Victoria Way, Woking, GU21 6QX
# Where the "book a consultant" button points — e.g. your Calendly link.
BRAND_CTA_URL=https://www.betechsecure.co.uk
BRAND_CTA_LABEL=Schedule a call with a security consultant
